 "poems": [
  {
   "seq": "1",
   "text": "朝日山ふもとの里の卯花をさらせる布と思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "おほつかなまつ人からの時鳥なとふた聲ときなかさるらん",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "萬代をふへきよとのゝあやめ草なかき妻とや君もみるらん",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "色ふかく門田の早苗なりにけりいそけしつのおふしも社たて",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "我こひの心にかなふものならは人のつらさも恨さらまし",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "年ことにかはらぬものは春霞たつたの山のけしき成けり",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "いかはかりてる月なれやまくすはふ森の下草かすみゆるまで",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "かきりても君かよはひは石〓水なかれむよには絕しとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "月影に尋きたれは時鳥なく山のはによこくもわたる",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "梓弓かへるあしたの思ひにはひきくらふへき物なかりけり",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "秋とにたれかそむらんぬしふらぬからくれなゐの衣手の森",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "さゝ波や舟木の山の時鳥聲をほにあけて鳴わたるなり",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "ふるらめや岩かけにおふる白菅のねふかくおもふ心有とは",
   "kana": "",
   "speaker": "顯輔卿集",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "こひしてふもしの關守いくたひか我がきつらん心つくしに",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "みかさ山もりくる月の〓けれは神の心もすみやしぬらむ",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "あふさかの關に〓水のなかりせはいかてか月の影をとめまし",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "夏衣ひとへにつらき人こふる我心こそうらなかりけれ",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "悅をくはふるたひの唐衣あやしくなとかたちうかるらむ",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "いつはらてしかと答へよ秋萩をしからみふすときくはまとか",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "けふやさは雪うちとけて鶯の都にいつる初音成らむ",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "萬代に見るへき花の色なれとけふの匂ひはいつかわすれん",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "けふさきてあすは靑葉になる花をみすてゝかへる人も有けり",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "おしむとていくかもあらし山櫻心のまゝにおりてかへらん",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "散はなをおしむはかりや世中の人の心のかはらさるらん",
   "kana": "",
   "speaker": "",
   "page": 262,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "紫の色のゆかりにふちの花かゝれる松もむつましきかな",
   "kana": "",
   "speaker": "顯輔卿集",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "限りあれはなかてもやまし時鳥人くるしめにまたれさらなん",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "ほとゝきす心も空にあくかれて夜かれかちなる深山へのさと",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "白露や心をくらん女郞花色めくのへに人かよふとて",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "としふれと人もすさめぬ我戀や朽木のそまの谷の埋木",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "今はさはあひみんまてはかたくとも命とならむ言のはもかな",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "こひわひてれぬよつもれは敷妙の枕さへ社うとくなりけれあ",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "ふとみてうつゝのかひはなけれともはかなき夢そ命也けるい",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "はね共したはいとなしをし鳥の浮きたる戀と思はさらなん",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "思ひやれめくりあふへき春たにもたちわかるゝは悲しき物を",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "家の風ふかぬ物ゆへはつかしの森のことのはちらしはてつる",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "いかてかは森のことのは忍ふへきこたかき宿の風のしけきに",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "風吹はさこそはたゆれたゆれとも又かきつけつさゝかにの糸",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "過つらん都のこともとふへきに雲のよそにもわたる月かな",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "身につみて照しおさめよます鏡たか僞もくもりあらすな",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いつのまに身を山かつになしはてゝ都をたひと思ふ成らん",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "たれもみな花の都へちりはてゝひとりしくるゝ秋の山里",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "わかたのむかもの川波立かへり嬉しきせゝにあふよしもかな",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "鶯のなく音はかりや春ならむ花ちりにけるみ山へのさと",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "かゝりける心つくしの牛のこをたれあつまちの駒といひけん",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "難波江のあしまに宿る月みれは我身ひとつもしつまさりけり",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "いつとなく忍ふも苦しえの薄ほに出て人にあふよしもかな",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "わきもこかすそのに匂ふふちはかま思ひそめてし心たかふな",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "君か世は限りもしらす長月のきくをいくたひつまむとすらん",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "身をつめはたな引雲もなき空に心ほそくもすめる月哉",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "枯はつる藤のすゑはの悲しきはたゝ春の日をたのむ計に",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "いかにせんとふひも今はたてわひぬ聲も通はぬあはち島山",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "忘るなよあはつの原のあはすとも今かへりこん葛の末はに",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "あはつのゝ葛の末葉のかへるまてありやはすへき露の命は",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "夜をかさねあかたの水の凍れるをさの春風けふそときつる",
   "kana": "",
   "speaker": "顯輔卿集",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "春風にあかたの氷とけぬれは沈むみくつもあらはれにけり",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "よもすからふしの高ねに雲消て〓みか關にすめる月影",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "山姬にちえの錦をたむけてもちる紅葉はをいかてとゝめん",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "つらからむことのはもかなわひつゝは恨てたにも慰めにせん",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "諸越のたまつむ舟のもとろけは思ひ定めんかたも覺えず",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "風をいたみたまつむ舟のもとろきは君はかり社まほに定めし",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "いかはかり隈なくてらす月なれは心のやみも晴るゝなるらん",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "山ひこのこたふる山に鳴鹿はおのか聲をやともときくらむ",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "あつまやのゝきのかやまの信夫草こひをは人の忍ふ物かは",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "野へに出て露けき華をみるよりも秋はさかたの數をかそへよ",
   "kana": "",
   "speaker": "",
   "page": 263,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "數ふへき山田のつほの内にいれは萩のなさけにしく花そなき",
   "kana": "",
   "speaker": "顯輔卿集",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "なにたかき今夜の月をみる程や心のうちのはれま成らん",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "くれなゐにたきの白糸そめてけり峰の紅葉やまなく散らん",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "いくらとかいふへかるらん萬代も君かためにはかすならぬ哉",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "よしあしも〓き鏡ぞてらすなる心のほとはこれにてをみよ",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "はし鷹の野寺のかゝみならねともよそなる人の心をそみる",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "浮身には都のてふりあきはてぬひなへ誘はんあつまつもかな",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "あら雲のたな引岑の櫻花かほらさりせはいかてしらまし",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "鶯の花のねくらにとまらすは夜深き聲をいかてきかまし",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "炭かまの烟にむせふをの山は峯の霞もおもなれにけり",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "山のはに關守すへよたつた姫おしむもしらぬ月やとまると",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "こけのむす岩かけまゆみ色ふかしこれを嵐にしらせすもかな",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "情なきことのはさへもなつかしき戀しきなかに通ふと思へは",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "たかためと急くなるらんよもすから槇のしま人衣うつ也",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "かそいろと賴むもしるし夜はの雨に小萩か原のたけそ增れる",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "すみかまの烟はかりはたゝすとも山里いかに淋しかるらん",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "我宿のものともいはし櫻花かゝる月日はあらしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "世中にけふそ佛の立いてゝあらはれたまふ水はくみける",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "時鳥さてしもやまし物ゆへに思はせたりや小夜更るまて",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "月の舟ひかりをさしていてぬめりこや彥星のあまの戶わたり",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "おなしくばこゝのへにさけ菊の花月日の數にかなふはかりに",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "はかなくて暮れぬる年をかそふれは我身も末になりにける哉",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "三室山みねにあさひのうつろへは昔の川に月そのこれる",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "名のみしてさしも嵐を百瀨川ゆゝしき瀨をは我そすきにし",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "君か代にくらまの山の岩ね松いくたひはかりおひ變りなん",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "その色とめには見えぬを春雨の野への綠をいかてそむらん",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "契りけん程やすきぬと急くらむよるもすかるにかへる雁金",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "かほらすは誰かゑらまし梅花しらつき山の雪のあけほの",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "まことにやあかしかぬらん夏のよを獨ね覺の人にとはゝや",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "梓弓たかまと山にともす火はほくしにかけているにや有覽",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "朝またきおれふしにけりよもすから露をきあかす撫子の花",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "聲たかしすこしたちのけ葢さこそは草の枕なりとも",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "かるの池の入江をめくる鴨とりのうはけはたらにをける朝露",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "あふみちや野島かさきの濵風に夕波千とり立さはくなり",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "紅葉はをよもの嵐はさそへともみなこのもとにかへる成けり",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "昔〓り人まとふとはきゝしかと山てふ山にけふよりそいる",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "淺ましや千島のえそのつくるなるとくきのや社ひまはもるなれ",
   "kana": "",
   "speaker": "顯輔卿集",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "ひと夜とはいのらさりしをかひもなく心定めぬうきふまの神",
   "kana": "",
   "speaker": "",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "人心やすのこほりときくなへにつけとつきせすはこふ稻かな",
   "kana": "",
   "speaker": "野洲郡",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "千早振みかみの山の榊はをかをがくはしみとめて社とれ",
   "kana": "",
   "speaker": "三上山",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "雲かゝる高みくら山のほる日のはるかに見ゆる君か御代かな",
   "kana": "",
   "speaker": "高御倉山",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "濁なきたまかけのゐの底きよみすみよき世にもあひにける哉",
   "kana": "",
   "speaker": "玉蔭井",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "君か世はなからの山の岩ね松ちたひやちたひ花の咲まて",
   "kana": "",
   "speaker": "長等山",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "やすみしる我おほ君の御代に社いとゝやすらの里もとみぬれ",
   "kana": "",
   "speaker": "安良〓",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "四方の海波もをととぬ君か代とよろこひわたるさのゝ船橋",
   "kana": "",
   "speaker": "佐野船橋",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "いつしかと朝日の里をたちいでゝ急きもはこふみつき物かな",
   "kana": "",
   "speaker": "朝日〓",
   "page": 264,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "萬代とおほとみ山そよはふなる久しく君をさかゆへしとか",
   "kana": "",
   "speaker": "顯輔卿集",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "君か代はたのしかるらし常よりも年へてみゆる秋とみの村",
   "kana": "",
   "speaker": "秋富村",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "君か代はなかみれ山に二葉なる小松の千たひおひかはるまて",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "はる〓〓とみやりの岡の若菜、そ千歲の春はつむへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "何れをかわきてもおらん梅はらは心にそまぬ色し見えねは",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "君か代もたみの心の一かたに靡きてみゆる靑柳のむら",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "八重たてるしら雲山の櫻花かほるはかりやしるし成らん",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "いはねともくちなし色にしろきかなこや音にきく山吹のさき",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "年每にたえすひくかなあやめ草ねもなかさはの池をたつねて",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "見渡せはちくらの里にあまろまて數もしられすとる早苗哉",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "宿每にうへける花のかひありて咲みたれたるとこなつの里",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "昔より名になかれたる岩瀧の水のしらいといくよへぬらん",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "色〓の千草の原をみわたせはいくらはかりのにしき成らん",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "くもりなくすむ玉のゐにいとゝしく光をそふる夜はの月哉",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "板倉の山田につめるいねをみておさまれるよの程をしる哉",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "貢物はこふよほろしおほけれはみちもさりあへす逢坂の關",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "日にそへてあかくそみゆるかゝみ山紅葉の色や深く成らん",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "御狩するたかのお山にたつきしや君か干とせのひつき成らん",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "すへらきを守り益田の森なれやあから柏のあからめもせず",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "あさまたきふりさけみれは白妙の雪つもれるや高宮の里",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "いかてわれ心の月をあらはしてやみにまとへる人をてらさむ",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "すみの江にやとれる月の村雲は松のしつえのかけにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "いくへとか籬のきくを思はまし今夜の月のなへてなりせは",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "年ふともこしのしら山わすれすははしらの雪を哀ともみよ",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "住吉の松の絕まの紅葉にやつもりの蜑は秋をしるらん",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "小夜更てかけひの水のとまりしに心はえてき今朝の初雪",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "夏引のいとのみたれもかくれなくこやのしのやをてらす月影",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "ますらおか朝ふむのらをみわたせは雲ゐ遙にかゝるせこなは",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "くれのあき月の姿はたえねとも光は空にみちにけるかな",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "人まねの戀にそ老はわすれぬる昔の心いまたありけり",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "きのふみし忍ふのみたれ誰ならん心のほとそかきりしられぬ",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "命あれはおほくの秋になりぬれと今年はかりの花は見さりき",
   "kana": "",
   "speaker": "顯輔〓集",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "かはよりの花の匂ひををきなから又もみさらん事そかなしき",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "いつしかと明行空のかすめるは天の戶よりや春はたつらん",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "郭公あかて過ぬる聲によりあとなき空になかめつるかな",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "天川よこきる雲や織女の空たきものゝけふりなるらむ",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "梅のえに降つむ雪は驚の羽かせにちるも花かとそ見る",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "かつらきやたかまの山の櫻花雲あのよそにみてやすきなん",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "村〓〓に咲るかきねの卯花は木のまの月のこゝち社すれ",
   "kana": "",
   "speaker": "",
   "page": 265,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "五月雨の日數へぬれはかりつみし賤やの小菅くちやしぬらん",
   "kana": "",
   "speaker": "顯輔〓集",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "難波かた入江をめくる蘆鴨の玉もの床にうきねすらしも",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "たのむれと心かはりて歸りこはこれそやかての別なるへき",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "おもへともいはての山に年をへてくちや果なん谷のむもれ木",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "高砂の尾上の松に吹かせの音にのみやはきゝわたるへき",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "よそにしてもときし人にいつしかと袖の雫をとはるへき哉",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "年ふれと哀にたえぬ泪かな戀しき人のかゝらましかは",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "東路の野島かさきの濱風よ我ひもゆひし妹か顏のみ俤にみゆ",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "麓まて尾上の櫻ちりこすはたなひく雲と見でや過まし",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "秋風にたなひく雲のたえまよりもれいつる月の影そさやけき",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "たれもみな華の都に散果てひとりしくるゝ秋の山里",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "雪ふかき吉野の山のたかねとり空さへさえて出る月かけ",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "としふとも猶いはしろの結ひ松とけぬ物ゆへ人も社しれ",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "つらけれときのふ賴めし言のはにおちくる瀧ものとけかられは",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "さらぬたにね覺かちなる冬のよをならの枯葉に霰ふる也",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "いかにせん玉江の芦の下ねのみ世をへてなけとしる人もなき",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "つらしとて心のまゝに恨ても後は思ひにたへんものかは",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "思ふこと晴せめ比はかきくらす時雨もよその物とやはみる",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "傷とかつしりなからけふまてに賴むや戀の餘りなるらん",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "うちなひき春立きぬと鶯のまた里なれぬ初音なくなり",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "命をそちる花よりもおしむへきさすかにさかぬ春しなけれは",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "隱れぬにおふるあやめもけふは猶尋ねてひかぬ人やなからん",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "衣てのまた薄けれは朝またき身にしむものは秋のはつ風",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "家の風吹つたへすはこのもとにあたら紅葉のくちや果まし",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "時鳥なきて過ぬる一こゑのいかて心にとまるなるらむ",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "我戀はむすふ泉の水なれやたえすなかれて袖ぬるゝかな",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "春來めとおもふはかりのしるしには心のうちそ長閑なりける",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "織女の天の岩舟こよひこそ秋風ふきてまほに逢ふらめ",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "人つてといはぬはかりそ郭公聞ともなくて過ぬなる哉",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "草枕袖のみぬるゝたひ衣おもひたちけむほとそくやしき",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "身をしらていふはかひなき事なれと賴めは人をと思ふ計りそ",
   "kana": "",
   "speaker": "在明のつねなき名をも",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "河のぜにおふる玉もの行水になひきてもする夏秡かな",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "郭公夏くはゝれる年とてもみのくせなれやとこめつらなる",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "から錦しくとこなつの花なれは宿のかさりと誰かみさらん",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "今はきはあひみんまてはかたらはん命とならん旨のはもかな",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "またきより秋はたつたの川風の凉しきくれに思ひしらるれ",
   "kana": "",
   "speaker": "",
   "page": 266,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
